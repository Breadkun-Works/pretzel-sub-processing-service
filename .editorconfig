root = true

[*]
charset = utf-8 # 파일 인코딩을 UTF‑8로 고정
end_of_line = lf # 모든 줄바꿈을 LF(Line Feed)로 통일
insert_final_newline = true # 파일 마지막에 한 줄 띄워서 끝맺음
trim_trailing_whitespace = true # 줄 끝 불필요한 공백 자동 제거
indent_style = space # 들여쓰기를 스페이스 문자로 설정
indent_size = 4 # 들여쓰기 시 스페이스 4칸 사용
tab_width = 4 # 탭 문자를 쓸 경우 스페이스 4칸과 동등하게 취급

# Python 파일 전용 설정
[*.py]
# ▶ Python 파일은 위 기본 설정(스페이스 4칸, UTF‑8, LF 등)을 그대로 사용합니다
# ▶ 최대 줄 길이 같은 세부 룰은 Black(pyproject.toml)에서 관리

# JSON, YAML, TOML 파일 전용 설정
[*.{json,yml,yaml,toml}]
indent_size = 2 # 구성 파일은 스페이스 2칸 들여쓰기

# Markdown 및 텍스트 파일 전용 설정
[*.md]
trim_trailing_whitespace = false # 마크다운은 일부 렌더러가 줄 끝 공백을 활용하므로 제거하지 않음

# 셸 스크립트 파일 전용 설정
[*.sh]
indent_size = 2 # 스크립트는 스페이스 2칸 들여쓰기로 가독성 향상

# Makefile 전용 설정
[Makefile]
indent_style = tab # Makefile은 탭 문자가 필수 (탭만 인식)
